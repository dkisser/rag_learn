# Copy this file to .env and fill in real values.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
RETRIEVE_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=50

# Reranker (optional). Set RERANK_ENABLED=true to enable local cross-encoder reranking.
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
# Absolute number of candidates to fetch before reranking. If unset, uses retrieve_k * RERANK_FACTOR.
# RERANK_K=
RERANK_FACTOR=4
RERANK_BATCH_SIZE=8
# Device for sentence-transformers: "cpu", "cuda", "mps", or "auto".
RERANK_DEVICE=auto
# Cross-encoder 原始分数阈值，低于阈值的结果会被排除。
# 未设置时默认 0.001；留空可禁用。
RERANK_MIN_SCORE=0.001

# Chroma cosine distance 阈值，大于阈值的结果会被排除。
# 未设置时默认 1.0；留空可禁用。cosine distance 通常范围为 0..2。
# Hybrid 模式仅作用于 Chroma vector 侧；BM25 仍参与 RRF。
CHROMA_MAX_DISTANCE=1.0

# Hybrid retrieval (optional). Set HYBRID_ENABLED=true to fuse vector + BM25 (jieba) results.
HYBRID_ENABLED=false
# Reciprocal Rank Fusion constant k (higher = flatter mixing).
HYBRID_RRF_K=60

# Log verbosity: DEBUG, INFO (default), WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Intent-aware query routing (approach 1 + 3 combined).
# When intent_enabled=true, each user question is first classified as "specific" or "all".
# When intent="all" AND decompose_enabled=true, the question is split into sub-queries
# and each is retrieved independently (catalog-coverage mode); reranker is skipped.
INTENT_ENABLED=false
DECOMPOSE_ENABLED=false
INTENT_TIMEOUT_S=8.0
DECOMPOSE_TIMEOUT_S=15.0
DECOMPOSE_MAX=8
# CATALOG_SUB_K: candidates each sub-query pulls from each retriever (fan-out breadth).
# CATALOG_RECALL_K: how many survive the round-robin merge and reach the prompt (prompt size).
CATALOG_SUB_K=8
CATALOG_RECALL_K=20
